# Resend (お問い合わせフォーム送信用)
RESEND_API_KEY=re_xxxxx
CONTACT_TO_EMAIL=info@medpiano.com

# Cloudflare R2 (MP3ホスティング)
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-xxxxx.r2.dev
# 例: MP3のURLは ${NEXT_PUBLIC_R2_PUBLIC_URL}/tracks/track-01.mp3

# サイトメタ
NEXT_PUBLIC_SITE_URL=https://medpiano.com

# Neon Postgres (お問い合わせの保管。Vercel Marketplace経由で自動設定される)
DATABASE_URL=postgres://xxxxx

# お問い合わせ通知メールの送信先（未設定時は ko.kashiwai@gmail.com）
INQUIRY_ADMIN_EMAIL=ko.kashiwai@gmail.com

# アップロード管理画面 / お問い合わせ管理画面 共通パスワード
UPLOAD_PASSWORD=xxxxx

# Vercel Blob (アップロード機能用)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxx
